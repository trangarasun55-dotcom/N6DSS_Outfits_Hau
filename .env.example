# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.
API_URL=http://127.0.0.1:8000
# Để trống: hệ thống tự tạo và lưu khóa ở data/.secret_key. Hoặc đặt chuỗi ngẫu nhiên dài.
SECRET_KEY=
# Khóa Gemini lấy tại https://aistudio.google.com (để trống: dùng lời giải thích theo quy tắc)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Tài khoản quản trị tự tạo khi API khởi động (mật khẩu 12-128 ký tự)
ADMIN_EMAIL=admin@outfitai.local
ADMIN_PASSWORD=123456
SESSION_MAX_AGE_SECONDS=43200
COOKIE_SECURE=0
DB_PATH=data/app.db
DEFAULT_CITY=Hà Nội
TEMP_MODE=current
OPEN_METEO_PROXY=
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
FLASK_DEBUG=0
